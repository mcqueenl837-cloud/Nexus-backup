import chromadb
from sentence_transformers import SentenceTransformer

print("Loading embedding model...")

model_path=r"C:\Users\Kajal\.cache\huggingface\hub\models--sentence-transformers--all-MiniLM-L6-v2\snapshots\1110a243fdf4706b3f48f1d95db1a4f5529b4d41"

embedding_model=SentenceTransformer(model_path,local_files_only=True)

print("Embedding model loaded.")

chroma_client=chromadb.PersistentClient(path="chroma_storage")
collection=chroma_client.get_collection("book_content")

print(f"ChromaDB loaded.")
print(f"Records available: {collection.count()}")

def retrieve(question,n_results=3):
    query_embedding=embedding_model.encode(question).tolist()

    results=collection.query(
        query_embeddings=[query_embedding],
        n_results=n_results,
        include=["metadatas","documents","distances"]
    )

    return results

def display_results(question,results):
    print("\n"+"="*80)
    print(f"QUERY: {question}")
    print("="*80)

    metadatas=results["metadatas"][0]
    documents=results["documents"][0]
    distances=results["distances"][0]

    for i in range(len(documents)):
        print(f"\nRESULT {i+1}")
        print("-"*80)

        print(f"Topic: {metadatas[i]['topic_key']}")
        print(f"Placement: {metadatas[i]['placement']}")
        print(f"Page: {metadatas[i]['page']}")
        print(f"Distance: {distances[i]:.4f}")

        print("\nTextbook content:")
        print(documents[i][:1500])

        print("-"*80)

while True:
    question=input("\nAsk a question about the textbook (or type 'exit'): ")

    if question.lower().strip()=="exit":
        print("\nNexus retrieval stopped.")
        break

    if not question.strip():
        print("Please enter a question.")
        continue

    results=retrieve(question)
    display_results(question,results)

    
